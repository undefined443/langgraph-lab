# Copy to .env and fill in.  ``uv run`` loads .env automatically.

# --- LLM gateway (required) ---
# Default endpoint is OpenRouter. Any OpenAI-compatible gateway works.
LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Model slug the gateway expects. Must support function calling (tool use).
# luna = cheap/fast (lab default) | terra = balanced | sol = flagship
# Other models: anthropic/claude-sonnet-5 | google/gemini-3.7-flash | deepseek/deepseek-v4-flash
LLM_MODEL=openai/gpt-5.6-luna
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048

# --- LangSmith tracing (optional but the point of the demo) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=langgraph-lab
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # or the EU host
